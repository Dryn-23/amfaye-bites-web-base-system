+  background: var(--cream);
+  border: 1px solid var(--line);
+  border-left: 4px solid var(--green);
+  border-radius: 12px;
+  box-shadow: 0 8px 35px #30271c26;
+}
+.order-toast-icon {
+  color: var(--green);
+  flex-shrink: 0;
+  padding-top: 1px;
+}
+.order-toast > div {
+  flex: 1;
+  min-width: 0;
+}
+.order-toast strong {
+  display: block;
+  font-size: 13px;
+  line-height: 1.6;
+}
+.order-toast div > span {
+  display: block;
+  font-size: 10px;
+  color: var(--green-dark);
+  margin-top: 5px;
+  overflow-wrap: anywhere;
+}
+.order-toast p {
+  font-size: 11px;
+  line-height: 1.8;
+  margin: 8px 0;
+  color: var(--muted);
+}
+.order-toast div > button {
+  border: 0;
+  padding: 3px 0;
+  background: transparent;
+  display: flex;
+  gap: 7px;
+  align-items: center;
+  color: var(--green);
+  font-size: 11px;
+  font-weight: 600;
+}
+.order-toast > .icon-btn {
+  padding: 3px;
+  flex-shrink: 0;
+}
+@media (max-width: 1100px) {
+  .nav-wrap {
+    gap: 16px;
+  }
+  .nav-actions {
+    gap: 11px;
+  }
+}
+@media (max-width: 600px) {
+  .notification-panel {
+    position: fixed;
+    left: 12px;
+    right: 12px;
+    top: 104px;
+    width: auto;
+  }
+  .notification-list {
+    max-height: min(430px, calc(100dvh - 280px));
+  }
+  .nav-actions {
+    gap: 8px;
+  }
+  .notification-toggle {
+    width: 26px;
+  }
+  .order-toast-region {
+    bottom: 16px;
+    right: 16px;
+  }
+}
+@media print {
+  .notification-control,
+  .order-toast-region {
+    display: none !important;
+  }
+}
